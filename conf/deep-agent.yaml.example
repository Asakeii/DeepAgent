mcp:
  servers:
    tavily:
      command: "npx"
      args: ["-y", "tavily-mcp@0.1.3"]
      env:
        TAVILY_API_KEY: "<your tavily api key>"
    firecrawl:
      command: "npx"
      args: ["-y", "firecrawl-mcp"]
      env:
        FIRECRAWL_API_KEY: "<your firecrawl api key>"
    python:
      command: "uv"
      args:
        - "--directory"
        - "/Users/gd-npc-1029/Documents/CodeBase/deepAgent/mcps/python"
        - "run"
        - "server.py"
    remote-search:
      url: "http://localhost:3000/sse"
      headers:
        - "Authorization: Bearer <your token>"
      # Set DEEPAGENT_DEBUG_MCP=true before startup to print loaded tools.

model:
  default_model: "doubao-seed-2-0-mini-260428"
  api_key: "ark-xxxxx"
  base_url: "https://ark.cn-beijing.volces.com/api/v3"
  vision_model:              # 识图 agent 专用，初值复用上方；缺失回退主模型
    default_model: "<your vision model>"
    api_key: "ark-xxxxx"
    base_url: "https://ark.cn-beijing.volces.com/api/v3"
  # Optional named model profiles. Request body or user settings can select
  # one with model_profile, for example "fast" or "deep".
  profiles:
    fast:
      default_model: "<your fast model>"
      # api_key/base_url are optional; missing values inherit from model.api_key/base_url.
    deep:
      default_model: "<your stronger model>"
      api_key: "ark-xxxxx"
      base_url: "https://ark.cn-beijing.volces.com/api/v3"
  # Optional model price table for cost budgets. Values are USD per 1M tokens.
  # Keep this table in sync with your provider contract; the service does not
  # hardcode vendor prices.
  prices:
    doubao-seed-2-0-mini-260428:
      input_per_million: 0.0
      output_per_million: 0.0
      cached_input_per_million: 0.0
      reasoning_per_million: 0.0

setting:
  max_plan_iterations: 1
  max_step_num: 3
  enable_background_investigation: false
  # 0 disables whole-run timeout. Configure a positive value in production.
  run_timeout_seconds: 600

database:
  dsn: "root:deepagent@tcp(mysql:3306)/deepagent?parseTime=true"

server:
  allowed_origins: ["http://localhost:5173", "http://127.0.0.1:5173"]
  max_body_bytes: 1048576
  image_max_bytes: 5242880
  image_allowed_types: ["image/jpeg", "image/png", "image/webp", "image/gif"]
  # Empty url_allowed_hosts allows public HTTP(S) hosts except denied/private targets.
  # Patterns support exact host and wildcard suffix such as "*.example.com".
  url_allowed_hosts: []
  url_denied_hosts: []
  url_allow_private_networks: false
  # Empty api_keys disables API-key auth for local development.
  # Configure one or more keys in production and pass Authorization: Bearer <key>.
  api_keys: []
  # Admin APIs require one of these keys when configured. Do not reuse normal user API keys.
  admin_api_keys: []
  # Requires Redis to be initialized; 0 disables rate limiting.
  rate_limit_per_minute: 60
  # 0 uses the default heartbeat interval; negative disables SSE heartbeat.
  sse_heartbeat_seconds: 15
  # Optional PDF renderer for artifact export. If command is empty, the service
  # tries common Chrome/Chromium binaries. {{input}} is a file:// URL and
  # {{output}} is the target PDF path.
  pdf_renderer_command: "chromium"
  pdf_renderer_args:
    - "--headless"
    - "--disable-gpu"
    - "--no-sandbox"
    - "--no-pdf-header-footer"
    - "--print-to-pdf={{output}}"
    - "{{input}}"
  pdf_renderer_timeout_seconds: 30
